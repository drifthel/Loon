
#!name = iThome 网页广告清理
#!desc = 清理 IT 之家好物推荐、商品推广及底部 App Banner
#!author = drifthel
#!loon_version = 3.5.1

[Script]
response if ${url} ~= /^https?:\/\/([A-Za-z0-9-]+\.)*ithome\.com\// && ${response.status} == 200 && ${response.header['Content-Type']} ~= /text\/html/i then script("iThome.js") with requires_body=true, tag="iThome 网页广告清理"

[MITM]
hostname = ithome.com, *.ithome.com
